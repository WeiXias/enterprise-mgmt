# 企业一体化管理系统 环境变量配置
# 复制此文件为 .env 并填入真实值

# JWT 密钥（生产环境请用随机生成的强密钥）
JWT_SECRET=
JWT_REFRESH_SECRET=

# SMTP 邮件配置
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@company.com

# 数据库路径（默认 data/enterprise.db）
# DB_PATH=data/enterprise.db

# 应用名称
NUXT_PUBLIC_APP_NAME=企业一体化管理系统

# AI 调用加密密钥（用于存储第三方 API Key，与 JWT 密钥分开）
# ENCRYPTION_KEY=
